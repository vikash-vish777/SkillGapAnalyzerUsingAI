# Production Backend REST API Base URL
# For Vercel + Cloud Backend (e.g. Render / Railway / AWS):
VITE_API_BASE_URL=https://skill-gap-analyzer-api.onrender.com/api

# For Docker Single-Host / Nginx Reverse Proxy Deployment:
# Leave as /api because Nginx proxies /api/ requests to the backend container
# VITE_API_BASE_URL=/api

