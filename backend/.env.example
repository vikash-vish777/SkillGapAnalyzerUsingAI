# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-skill-gap-analyzer-key-change-in-production
JWT_SECRET_KEY=jwt-secret-skill-gap-analyzer-token-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (MySQL 8.0)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skill_gap_db

# Fallback mode: if set to true, Flask uses SQLite locally until MySQL credentials are provided
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=instance/skill_gap_local.db

# CORS Configuration (Allowed origins separated by comma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATELIMIT_DEFAULT=100 per minute

# File Upload Limits
MAX_CONTENT_LENGTH_MB=5

