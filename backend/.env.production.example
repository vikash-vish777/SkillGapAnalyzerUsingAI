# Production Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-64-character-secret-key-for-prod
JWT_SECRET_KEY=generate-a-different-strong-random-jwt-secret-key-for-prod
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Production Database (Cloud MySQL, AWS RDS, PlanetScale, Aiven, or Docker MySQL)
DB_USER=skill_user
DB_PASSWORD=strong_production_database_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=skill_gap_db
USE_SQLITE_FALLBACK=false

# Allowed Origins (Comma-separated URLs of your production frontend)
# E.g.: https://your-skill-gap-app.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=https://your-skill-gap-app.vercel.app

# Server Binding
HOST=0.0.0.0
PORT=5000
WAITRESS_THREADS=8

# Rate Limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Security & Uploads
MAX_CONTENT_LENGTH_MB=5

